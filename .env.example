# WorkOS development configuration. Copy this file to .env and fill in values.
# Use the separate WorkOS environment for this platform.
# Never commit .env, share its values in chat, or use production keys for development.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Configure these when the token profile and interactive login are ready.
WORKOS_ISSUER=
WORKOS_AUDIENCE=
WORKOS_REDIRECT_URI=
WORKOS_COOKIE_PASSWORD=
